{
  "threshold": 15,
  "reporters": ["console", "markdown"],
  "ignore": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/build/**",
    "**/*.min.*",
    "**/tests/e2e/testdata/**",
    "**/debug/**",
    "**/warpdl",
    "**/*.sum",
    "**/*.mod",
    "**/*_test.go"
  ],
  "format": ["go"],
  "minLines": 5,
  "minTokens": 50,
  "absolute": true,
  "gitignore": true,
  "blame": false,
  "silent": false,
  "output": "./reports/jscpd"
}
